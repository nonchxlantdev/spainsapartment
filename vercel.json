{
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @spains-apartment/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "apps/api/src/db/schema.sql,apps/api/assets/**"
    }
  }
}
